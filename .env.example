# Copy to .env.local and fill in. Never commit real values.
# Neon -> project -> Connect -> connection string (pooled, sslmode=verify-full)
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"

# Auth.js session key: generate with `npx auth secret` (or any 32+ random bytes, base64)
AUTH_SECRET="replace-with-random-secret"
# Google OAuth (optional; the Google button is hidden while empty).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
#                           https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe TEST mode (optional; the Stripe button is hidden while empty). Only sk_test_ keys are used;
# a live key is ignored on purpose. Stripe Dashboard -> Developers -> API keys -> Secret key (test mode).
STRIPE_SECRET_KEY=""
